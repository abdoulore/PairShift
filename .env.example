# Pyth Hermes API key (required for live execution). Get one at https://pythdata.app/signup
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# Solana mainnet RPC. The public endpoint works for demos; a Helius/Triton URL is more reliable.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter swap API. lite-api needs no key; set JUPITER_API_URL=https://api.jup.ag/swap/v1 plus a key for higher limits.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Keeper wallet (base58 secret key). Generate with: npm run keygen
KEEPER_SECRET_KEY=

# Global kill switch for real on-chain switches. Paper mode always works.
LIVE_EXECUTION=true
PORT=8787
